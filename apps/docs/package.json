{
    "name": "@jamcaa/docs",
    "version": "0.0.0",
    "private": true,
    "description": "Official documentation site, built with jamcaa itself",
    "scripts": {
        "dev": "next dev --port 2727",
        "build": "next build",
        "start": "next start --port 2727",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply jamcaa-docs --local",
        "db:migrate:remote": "wrangler d1 migrations apply jamcaa-docs --remote"
    },
    "//": "next and eslint-config-next are pinned to exact versions on purpose. The Cloudflare adapter patches Next's server to stop it pulling in sharp, whose native binaries cannot be bundled for Workers. That patch is version-specific: on 16.3.0 it silently fails to apply and the build dies on .node files. Only bump this together with @opennextjs/cloudflare, and verify `pnpm preview` afterwards.",
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@jamcaa/core": "workspace:*",
        "@jamcaa/editor": "workspace:*",
        "@opennextjs/cloudflare": "^1.20.2",
        "better-auth": "^1.6.26",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.30.0",
        "next": "16.2.11",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "shadcn": "^4.16.2",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.20.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.11",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^4.1.10",
        "wrangler": "^4.120.0"
    }
}
