# Copy to .dev.vars and fill in. .dev.vars is gitignored.

# Load .env.development* files when running `wrangler dev`
NEXTJS_ENV=development

# At least 32 characters, high entropy. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL this app is served from.
BETTER_AUTH_URL=http://localhost:3000

# The binding uploads through the server; a browser writing straight to the bucket
# needs a signed address, and only the S3 API can produce one.
# Cloudflare dashboard: R2 > API > Manage API tokens > Create token,
# permission "Object Read & Write", scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
