{
    "name": "@jamcaa/core",
    "version": "0.0.0",
    "private": true,
    "description": "The jamcaa publishing core",
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./auth": "./src/auth/index.ts",
        "./content": "./src/content/index.ts",
        "./dates": "./src/dates/index.ts",
        "./db": "./src/db/index.ts",
        "./db/schema": "./src/db/schema/index.ts",
        "./media": "./src/media/index.ts",
        "./settings": "./src/settings/index.ts",
        "./theme": "./src/theme/index.ts"
    },
    "scripts": {
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "auth:generate": "auth generate --config ./auth.ts --output ./src/db/schema/auth.ts --yes && prettier --write ./src/db/schema/auth.ts"
    },
    "dependencies": {
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.6.26",
        "culori": "^4.0.2",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.20.3",
        "@cloudflare/workers-types": "^5.20260808.1",
        "@types/culori": "^4.0.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "auth": "^1.6.26",
        "eslint": "^9",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
